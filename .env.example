# Server
NODE_ENV=development
PORT=3000

# Database
# Use a MySQL-compatible database connection URL.
DATABASE_URL=

# Auth and sessions
# Generate a strong value before running in production.
JWT_SECRET=
OWNER_OPEN_ID=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123456789
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=

# Storage, maps, image generation, and transcription proxy
# These endpoints are optional for local UI preview, but save/share/upload
# workflows require a compatible storage proxy.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# PM2 production overrides
PM2_LOG_DIR=./logs
NODE_INTERPRETER=node
PM2_RUN_USER=
PM2_RUN_GROUP=
